# Copy these values into app/frontend/.env for same-Wi-Fi testing.
# Replace API_HOST with the computer's Wi-Fi IPv4 address from `ipconfig`.
ENVIRONMENT=development
API_HOST=192.168.1.25
DATA_ORIGIN=observed
AUTH_BASE_URL=https://adaptedmind-auth-api.onrender.com/api/v1/auth
SPECIALIST_BASE_URL=https://adaptedmind-auth-api.onrender.com/api/v1/specialists

# The local services use these ports:
# C5 authentication/dashboard: 8015
# C1 touch telemetry:          8025
# C2 speech analysis:          8020
