# Copy to app/frontend/.env for local testing.
# Replace API_HOST with the computer's Wi-Fi IPv4 address.
ENVIRONMENT=development
API_HOST=192.168.1.100
DATA_ORIGIN=observed
AUTH_BASE_URL=https://adaptedmind-auth-api.onrender.com/api/v1/auth
SPECIALIST_BASE_URL=https://adaptedmind-auth-api.onrender.com/api/v1/specialists

# Optional per-service overrides. Leave these commented to use API_HOST and
# the standard local ports shown below.
# SPEECH_BASE_URL=http://192.168.1.100:8020
# TELEMETRY_BASE_URL=http://192.168.1.100:8025/api/v1/auth
# C1_BASE_URL=http://192.168.1.100:8025/api/v1/c1
# LEARNING_BASE_URL=http://192.168.1.100:8015/api/v1/learning
# PARENT_DASHBOARD_BASE_URL=http://192.168.1.100:8015/api/v1/parent/students
# THERAPIST_DASHBOARD_BASE_URL=http://192.168.1.100:8015/api/v1/therapist/students
